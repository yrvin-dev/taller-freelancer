# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local a git.

# Supabase (públicas, protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: borrar cuenta
SUPABASE_SERVICE_ROLE_KEY=

# Solo servidor: AES-256-GCM, 32 bytes en base64
CREDENTIALS_KEY=
# Solo durante una rotación de clave
CREDENTIALS_KEY_PREVIOUS=

# Redirect de OAuth
NEXT_PUBLIC_SITE_URL=

